# Configuración del cluster local
YOLO_MODEL_PATH=yolov8n.pt
CAMERA_FEED_URLS=rtsp://camera1,rtsp://camera2,rtsp://camera3
ALERT_THRESHOLD=0.7

# Configuración de la nube
CLOUD_STORAGE_BUCKET=zoo-historical-data
CLOUD_REGION=us-east-1
DATA_SYNC_INTERVAL=3600

# Credenciales AWS (no incluir en producción, usar IAM roles)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
